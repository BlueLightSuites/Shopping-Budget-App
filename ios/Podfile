require File.join(File.dirname(`node --print "require.resolve('expo/package.json')"`), "scripts/autolinking")
require File.join(File.dirname(`node --print "require.resolve('react-native/package.json')"`), "scripts/react_native_pods")

require 'json'
podfile_properties = JSON.parse(File.read(File.join(__dir__, 'Podfile.properties.json'))) rescue {}

def ccache_enabled?(podfile_properties)
  # Environment variable takes precedence
  return ENV['USE_CCACHE'] == '1' if ENV['USE_CCACHE']
  
  # Fall back to Podfile properties
  podfile_properties['apple.ccacheEnabled'] == 'true'
end

ENV['RCT_NEW_ARCH_ENABLED'] ||= '0' if podfile_properties['newArchEnabled'] == 'false'
ENV['EX_DEV_CLIENT_NETWORK_INSPECTOR'] ||= podfile_properties['EX_DEV_CLIENT_NETWORK_INSPECTOR']
ENV['RCT_USE_RN_DEP'] ||= '1' if podfile_properties['ios.buildReactNativeFromSource'] != 'true' && podfile_properties['newArchEnabled'] != 'false'
ENV['RCT_USE_PREBUILT_RNCORE'] ||= '1' if podfile_properties['ios.buildReactNativeFromSource'] != 'true' && podfile_properties['newArchEnabled'] != 'false'
platform :ios, podfile_properties['ios.deploymentTarget'] || '15.1'

prepare_react_native_project!

target 'Scrimpr' do
  use_expo_modules!

  if ENV['EXPO_USE_COMMUNITY_AUTOLINKING'] == '1'
    config_command = ['node', '-e', "process.argv=['', '', 'config'];require('@react-native-community/cli').run()"];
  else
    config_command = [
      'node',
      '--no-warnings',
      '--eval',
      'require(\'expo/bin/autolinking\')',
      'expo-modules-autolinking',
      'react-native-config',
      '--json',
      '--platform',
      'ios'
    ]
  end

  config = use_native_modules!(config_command)

  use_frameworks! :linkage => podfile_properties['ios.useFrameworks'].to_sym if podfile_properties['ios.useFrameworks']
  use_frameworks! :linkage => ENV['USE_FRAMEWORKS'].to_sym if ENV['USE_FRAMEWORKS']

  use_react_native!(
    :path => config[:reactNativePath],
    :hermes_enabled => podfile_properties['expo.jsEngine'] == nil || podfile_properties['expo.jsEngine'] == 'hermes',
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/..",
    :privacy_file_aggregation_enabled => podfile_properties['apple.privacyManifestAggregationEnabled'] != 'false',
  )

  post_install do |installer|
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      :ccache_enabled => ccache_enabled?(podfile_properties),
    )
    installer.pods_project.targets.each do |target|
      target.build_configurations.each do |config|
        config.build_settings['CLANG_CXX_LANGUAGE_STANDARD'] = 'c++20'
        # Fix Swift compiler segfault on x86_64 with Xcode 16.4 whole-module-optimization
        if config.name == 'Debug'
          config.build_settings['SWIFT_COMPILATION_MODE'] = 'singlefile'
        end
        # Fix clang segfault (Segmentation fault: 11) on x86_64 with Xcode 16.4 / Apple clang 17.0.0
        # Multiple stack overflow variants:
        # 1. llvm::DIE::computeOffsetsAndAbbrevs - DWARF debug info generation overflow
        # 2. clang::index::IndexingContext - index store generation overflow
        # Both triggered by deeply nested C++ template/namespace types in React Native pods.
        config.build_settings['GCC_OPTIMIZATION_LEVEL'] = '0'
        config.build_settings['OTHER_CPLUSPLUSFLAGS'] = '$(inherited) -O0 -fno-inline-functions'
        config.build_settings['GCC_GENERATE_DEBUGGING_SYMBOLS'] = 'NO'
        config.build_settings['DWARF_DSYM_FILE_SHOULD_ACCOMPANY_PRODUCT'] = 'NO'
        config.build_settings['COMPILER_INDEX_STORE_ENABLE'] = 'NO'
      end
    end

    # Also write COMPILER_INDEX_STORE_ENABLE=NO to all pod xcconfig files so it cannot be
    # overridden by the xcodebuild command-line default (which forces index-store generation).
    # This fixes the clang stack overflow in IndexingContext on x86_64 + Xcode 16.4.
    xcconfig_dir = File.join(__dir__, 'Pods', 'Target Support Files')
    Dir.glob(File.join(xcconfig_dir, '**', '*.xcconfig')).each do |xcconfig_path|
      content = File.read(xcconfig_path)
      unless content.include?('COMPILER_INDEX_STORE_ENABLE')
        File.open(xcconfig_path, 'a') { |f| f.puts "\nCOMPILER_INDEX_STORE_ENABLE = NO" }
      end
      unless content.include?('GCC_GENERATE_DEBUGGING_SYMBOLS')
        File.open(xcconfig_path, 'a') { |f| f.puts "GCC_GENERATE_DEBUGGING_SYMBOLS = NO" }
      end
    end

    # Fix EXConstants build phase script failing when project path contains spaces,
    # and when get-app-config-ios.sh uses #!/usr/bin/env bash (bash not in Xcode PATH).
    # Solution: run the script directly with /bin/bash, bypassing shebang resolution.
    installer.pods_project.targets.each do |target|
      if target.name == 'EXConstants'
        target.shell_script_build_phases.each do |phase|
          if phase.shell_script.include?('get-app-config-ios.sh')
            phase.shell_script = '/bin/bash "$PODS_TARGET_SRCROOT/../scripts/get-app-config-ios.sh"'
          end
        end
      end
    end
  end
end
