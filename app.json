{
  "expo": {
    "name": "Scrimpr",
    "slug": "scrimpr",
    "owner": "blue-light-suites-llc",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/scrimpr_app_icon_1024.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.bluelightsuitesllc.scrimpr",
      "infoPlist": {
        "NSCameraUsageDescription": "This app uses the camera to scan barcodes for product information.",
        "NSMicrophoneUsageDescription": "This app uses the microphone for audio feedback."
      }
    },
    "android": {
      "package": "com.bluelightsuitesllc.scrimpr",
      "adaptiveIcon": {
          "foregroundImage": "./assets/scrimpr_app_icon_1024.png",
          "backgroundColor": "#FFFFFF"
        },
      "permissions": [
        "CAMERA",
        "RECORD_AUDIO",
        "VIBRATE"
      ]
    },
    "web": {
      "favicon": "./assets/scrimpr_app_icon_1024.png"
    },
    "plugins": [
      "expo-dev-client",
      "expo-camera",
      "expo-av",
      "expo-font",
      "expo-asset"
    ],
    "extra": {
      "KROGER_CLIENT_ID": "price-scanner-bbc668lf",
      "eas": {
        "projectId": "5528be22-e93e-4301-aa9b-2dbe6ba9ccaf"
      }
    }
  }
}
